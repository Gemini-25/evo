{
  "format": "evolab-template",
  "version": 1,
  "id": "disc",
  "kind": "body",
  "world": "top",
  "name_id": "disc",
  "params": [
    {"id": "size", "label_id": "size", "value": 1.0, "min": 0.75, "max": 1.25, "step": 0.05, "unit_id": "times", "main": true},
    {"id": "power", "label_id": "power", "value": 1.0, "min": 0.6, "max": 1.5, "step": 0.05, "unit_id": "times", "main": true}
  ],
  "root": "disc",
  "parts": {
    "bodies": [
      {"id": "disc", "label": "선수", "pos": [0.0, 0.0], "shapes": [{"kind": "circle", "r": "=t.size * 0.4"}], "material": {"density": 50.0, "friction": 0.3, "elasticity": 0.2}, "tags": ["player"], "drag": "=t.size * t.size * 120"}
    ],
    "actuators": [
      {"kind": "thruster", "id": "go_up", "label": "위로", "body": "disc", "at": [0.0, 0.0], "dir": 1.5707963267948966, "max_force": "=t.power * t.size * t.size * 400", "keys": ["Up", "W"]},
      {"kind": "thruster", "id": "go_down", "label": "아래로", "body": "disc", "at": [0.0, 0.0], "dir": -1.5707963267948966, "max_force": "=t.power * t.size * t.size * 400", "keys": ["Down", "S"]},
      {"kind": "thruster", "id": "go_left", "label": "왼쪽으로", "body": "disc", "at": [0.0, 0.0], "dir": 3.141592653589793, "max_force": "=t.power * t.size * t.size * 400", "keys": ["Left", "A"]},
      {"kind": "thruster", "id": "go_right", "label": "오른쪽으로", "body": "disc", "at": [0.0, 0.0], "dir": 0.0, "max_force": "=t.power * t.size * t.size * 400", "keys": ["Right", "D"]}
    ],
    "sensors": [
      {"kind": "body_state", "id": "st", "label": "내 움직임", "body": "disc", "fields": ["vx", "vy"], "frame": "world", "scale": {"vx": 3.5, "vy": 3.5}}
    ]
  },
  "slots": {}
}
