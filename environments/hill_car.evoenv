{
  "version": 1,
  "name": "언덕 넘는 자동차",
  "description": "모터 바퀴 두 개로 점점 험해지는 언덕길을 넘어간다. 바퀴 크기와 차체 모양(몸 수치)도 함께 진화한다.",
  "world": {
    "kind": "physics2d",
    "gravity": [
      0.0,
      -9.81
    ],
    "dt": 0.016666666666666666,
    "max_time": 30.0,
    "bounds": [
      -30.0,
      -60.0,
      460.0,
      200.0
    ],
    "contact_debounce": 0.1
  },
  "params": [
    {
      "id": "half",
      "label": "차체 반길이",
      "value": 1.1,
      "evolve": true,
      "min": 0.7,
      "max": 1.8
    },
    {
      "id": "nose",
      "label": "앞 높이",
      "value": 0.35,
      "evolve": true,
      "min": 0.1,
      "max": 0.9
    },
    {
      "id": "tail",
      "label": "뒤 높이",
      "value": 0.35,
      "evolve": true,
      "min": 0.1,
      "max": 0.9
    },
    {
      "id": "rear_r",
      "label": "뒷바퀴 반지름",
      "value": 0.5,
      "evolve": true,
      "min": 0.25,
      "max": 1.0
    },
    {
      "id": "front_r",
      "label": "앞바퀴 반지름",
      "value": 0.5,
      "evolve": true,
      "min": 0.25,
      "max": 1.0
    }
  ],
  "randomize": [
    {
      "id": "hseed",
      "label": "언덕 시드",
      "dist": "int",
      "low": 0,
      "high": 1000000000
    }
  ],
  "generators": [
    {
      "kind": "hills",
      "id": "ground",
      "label": "언덕길",
      "seed": "=r.hseed",
      "x_range": [
        -20.0,
        420.0
      ],
      "segment": 1.0,
      "base_y": 0.0,
      "amplitude": 0.5,
      "growth": 0.03,
      "roughness": 0.7,
      "slope": 0.06,
      "flat_start": 25.0,
      "friction": 0.9
    }
  ],
  "agent": {
    "spawn": {
      "x": 0.0,
      "y": "=max(p.rear_r, p.front_r) + 0.6"
    }
  },
  "bodies": [
    {
      "id": "chassis",
      "label": "차체",
      "owner": "agent",
      "shapes": [
        {
          "kind": "poly",
          "points": [
            [
              "=-p.half",
              -0.25
            ],
            [
              "=p.half",
              -0.25
            ],
            [
              "=p.half",
              "=p.nose"
            ],
            [
              "=-p.half",
              "=p.tail"
            ]
          ]
        }
      ],
      "material": {
        "density": 20.0,
        "friction": 0.5
      },
      "tags": [
        "chassis"
      ]
    },
    {
      "id": "wheel_r",
      "label": "뒷바퀴",
      "owner": "agent",
      "pos": [
        "=-p.half",
        -0.25
      ],
      "shapes": [
        {
          "kind": "circle",
          "r": "=p.rear_r"
        }
      ],
      "material": {
        "density": 10.0,
        "friction": 1.0
      },
      "tags": [
        "wheel"
      ]
    },
    {
      "id": "wheel_f",
      "label": "앞바퀴",
      "owner": "agent",
      "pos": [
        "=p.half",
        -0.25
      ],
      "shapes": [
        {
          "kind": "circle",
          "r": "=p.front_r"
        }
      ],
      "material": {
        "density": 10.0,
        "friction": 1.0
      },
      "tags": [
        "wheel"
      ]
    }
  ],
  "joints": [
    {
      "id": "j_r",
      "label": "뒷바퀴 축",
      "kind": "pivot",
      "a": "chassis",
      "b": "wheel_r",
      "anchor_a": [
        "=-p.half",
        -0.25
      ]
    },
    {
      "id": "j_f",
      "label": "앞바퀴 축",
      "kind": "pivot",
      "a": "chassis",
      "b": "wheel_f",
      "anchor_a": [
        "=p.half",
        -0.25
      ]
    }
  ],
  "actuators": [
    {
      "kind": "motor",
      "id": "m_r",
      "label": "뒷바퀴 모터",
      "joint": "j_r",
      "max_torque": 150.0,
      "max_speed": 15.0,
      "keys_pos": [
        "Left",
        "A"
      ],
      "keys_neg": [
        "Right",
        "D"
      ]
    },
    {
      "kind": "motor",
      "id": "m_f",
      "label": "앞바퀴 모터",
      "joint": "j_f",
      "max_torque": 150.0,
      "max_speed": 15.0,
      "keys_pos": [
        "Left",
        "A"
      ],
      "keys_neg": [
        "Right",
        "D"
      ]
    }
  ],
  "sensors": [
    {
      "kind": "body_state",
      "id": "st",
      "label": "차체 상태",
      "body": "chassis",
      "fields": [
        "vx",
        "vy",
        "angle",
        "omega"
      ],
      "frame": "world",
      "scale": {
        "vx": 5.0,
        "vy": 5.0,
        "angle": 1.5,
        "omega": 3.0
      }
    },
    {
      "kind": "rays",
      "id": "ray",
      "label": "앞쪽 땅까지 거리",
      "body": "chassis",
      "origin": [
        "=p.half",
        0.0
      ],
      "count": 5,
      "spread": 1.6,
      "center": -0.9,
      "length": 10.0,
      "hits": [
        "tag.terrain"
      ]
    },
    {
      "kind": "contact",
      "id": "c_r",
      "label": "뒷바퀴 접지",
      "body": "wheel_r",
      "with": [
        "tag.terrain"
      ]
    },
    {
      "kind": "contact",
      "id": "c_f",
      "label": "앞바퀴 접지",
      "body": "wheel_f",
      "with": [
        "tag.terrain"
      ]
    }
  ],
  "events": [
    {
      "id": "finish",
      "label": "끝까지",
      "when": "chassis.x > gen.ground.x_max - 15"
    },
    {
      "id": "crash",
      "label": "뒤집힘",
      "when": "contact(chassis, tag.terrain)"
    },
    {
      "id": "stall",
      "label": "정체",
      "when": "chassis.vx < 0.3",
      "hold": 3.0
    }
  ],
  "termination": [
    {
      "event": "finish",
      "outcome": "success",
      "label": "끝까지"
    },
    {
      "event": "crash",
      "outcome": "failure",
      "label": "뒤집힘"
    },
    {
      "event": "stall",
      "outcome": "failure",
      "label": "정체"
    },
    {
      "event": "out_of_bounds",
      "outcome": "failure",
      "label": "이탈"
    },
    {
      "event": "timeout",
      "outcome": "neutral",
      "label": "시간 초과"
    }
  ],
  "scoring": {
    "blocks": [
      {
        "kind": "progress",
        "id": "s_prog",
        "label": "전진 거리",
        "body": "chassis",
        "direction": 0.0,
        "weight": 1.0
      },
      {
        "kind": "event",
        "id": "s_finish",
        "label": "끝까지",
        "event": "finish",
        "weight": 100.0
      },
      {
        "kind": "event",
        "id": "s_crash",
        "label": "뒤집힘",
        "event": "crash",
        "weight": -20.0
      },
      {
        "kind": "energy",
        "id": "s_energy",
        "label": "에너지",
        "weight": -0.05
      }
    ]
  },
  "brain": {
    "inputs": "all",
    "hidden": [
      16
    ],
    "activation": "tanh",
    "outputs": "all"
  },
  "evaluation": {
    "trials": 3,
    "aggregate": "mean"
  }
}
