{
  "version": 2,
  "name": "점프 게임",
  "description": "다가오는 장애물을 점프로 넘으며 끝까지 버틴다. 장애물은 점점 빨라지고, 낮게 나는 장애물은 뛰면 부딪힌다.",
  "world": {
    "kind": "physics2d",
    "gravity": [
      0.0,
      -9.81
    ],
    "dt": 0.016666666666666666,
    "max_time": 40.0,
    "bounds": [
      -20.0,
      -5.0,
      40.0,
      25.0
    ],
    "contact_debounce": 0.1
  },
  "randomize": [
    {
      "id": "oseed",
      "label": "장애물 시드",
      "dist": "int",
      "low": 0.0,
      "high": 1000000000.0
    }
  ],
  "generators": [
    {
      "kind": "obstacles",
      "id": "obs",
      "label": "장애물 줄",
      "seed": "=r.oseed",
      "count": 40,
      "x": 20.0,
      "y": 0.0,
      "gap": [
        1.0,
        2.4
      ],
      "width": [
        0.5,
        1.5
      ],
      "height": [
        0.4,
        1.3
      ],
      "air_chance": 0.35,
      "air_y": [
        1.25,
        1.5
      ],
      "air_height": [
        0.4,
        0.8
      ],
      "speed": 6.0,
      "accel": 0.25,
      "direction": 3.141592653589793,
      "friction": 0.5
    }
  ],
  "agent": {
    "spawn": {
      "x": 0.0,
      "y": 0.0,
      "angle": 0.0,
      "vx": 0.0,
      "vy": 0.0,
      "omega": 0.0
    }
  },
  "bodies": [
    {
      "id": "ground",
      "label": "땅",
      "owner": "world",
      "type": "static",
      "pos": [
        10.0,
        -0.5
      ],
      "shapes": [
        {
          "kind": "box",
          "w": 80.0,
          "h": 1.0
        }
      ],
      "material": {
        "density": 1.0,
        "friction": 0.8,
        "elasticity": 0.0
      },
      "tags": [
        "ground"
      ]
    },
    {
      "id": "runner",
      "label": "달리기 선수",
      "owner": "agent",
      "type": "dynamic",
      "pos": [
        0.0,
        0.5
      ],
      "shapes": [
        {
          "kind": "box",
          "w": 0.6,
          "h": 1.0
        }
      ],
      "material": {
        "density": 50.0,
        "friction": 0.8,
        "elasticity": 0.0
      },
      "tags": [
        "runner"
      ]
    }
  ],
  "actuators": [
    {
      "kind": "jump",
      "id": "jump",
      "label": "점프",
      "body": "runner",
      "speed": 6.0,
      "ground": [
        "tag.ground"
      ],
      "cooldown": 0.25,
      "keys": [
        "Up",
        "W",
        "Space"
      ]
    }
  ],
  "sensors": [
    {
      "kind": "rays",
      "id": "eye",
      "label": "앞쪽 장애물까지 거리",
      "body": "runner",
      "origin": [
        0.3,
        -0.4
      ],
      "count": 7,
      "spread": 0.8,
      "center": 0.4,
      "length": 15.0,
      "hits": [
        "tag.obstacle"
      ]
    },
    {
      "kind": "body_state",
      "id": "st",
      "label": "높이·수직 속도",
      "body": "runner",
      "fields": [
        "y",
        "vy"
      ],
      "frame": "world",
      "scale": {
        "y": 2.0,
        "vy": 5.0
      }
    },
    {
      "kind": "contact",
      "id": "foot",
      "label": "땅에 닿음",
      "body": "runner",
      "with": [
        "tag.ground"
      ]
    },
    {
      "kind": "body_state",
      "id": "spd",
      "label": "장애물 속도",
      "body": "obs",
      "fields": [
        "vx"
      ],
      "frame": "world",
      "scale": {
        "vx": 10.0
      }
    }
  ],
  "events": [
    {
      "id": "hit",
      "label": "부딪힘",
      "when": "contact(runner, tag.obstacle)",
      "hold": 0.0
    }
  ],
  "termination": [
    {
      "event": "hit",
      "outcome": "failure",
      "label": "부딪힘"
    },
    {
      "event": "out_of_bounds",
      "outcome": "failure",
      "label": "이탈"
    },
    {
      "event": "timeout",
      "outcome": "success",
      "label": "끝까지 버팀"
    }
  ],
  "scoring": {
    "blocks": [
      {
        "id": "s_time",
        "label": "버틴 시간",
        "weight": 1.0,
        "kind": "survival_time"
      },
      {
        "id": "s_end",
        "label": "끝까지 버팀",
        "weight": 10.0,
        "kind": "event",
        "event": "timeout",
        "value": "occurred"
      }
    ],
    "formula": null
  },
  "brain": {
    "inputs": "all",
    "hidden": [
      16
    ],
    "activation": "tanh",
    "outputs": "all"
  },
  "evaluation": {
    "trials": 5,
    "aggregate": "mean",
    "target_score": null
  },
  "editor": {
    "view": [
      -4.0,
      -1.0,
      16.0,
      6.0
    ]
  }
}
