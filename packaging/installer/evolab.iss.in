; Generated by packaging/make_installer.py from packaging/installer/evolab.iss.in. Do not edit by hand.
; Every user-visible text comes from src/evolab/app/strings.py (APP_NAME, INST_*, DATA_DIR_NAME): the
; [CustomMessages] values and the name lines below. This template itself contains only ASCII.
; Template placeholders are words between at-signs, because Inno Setup already gives braces three meanings
; (constants, the doubled-brace escape and ISPP inline directives). Comments here never contain an ISPP directive.
#define AppVersion "@VERSION@"

[Setup]
; Fixed forever: a different AppId makes Windows treat the program as a different one (design D38).
AppId={@APP_ID@
AppName=@APP_NAME@
AppVersion={#AppVersion}
AppVerName=@APP_NAME@ {#AppVersion}
AppPublisher=@PUBLISHER@
VersionInfoVersion=@VERSION4@
; Per-user install into %LOCALAPPDATA%\Programs without administrator rights (design D36).
; /ALLUSERS on the command line installs for all users instead; the wizard never asks.
DefaultDirName={autopf}\@APP_NAME@
DefaultGroupName=@APP_NAME@
DisableProgramGroupPage=yes
DisableDirPage=auto
DisableReadyPage=yes
UsePreviousAppDir=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=commandline
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
WizardStyle=modern
SetupIconFile=@ICON@
UninstallDisplayIcon={app}\evolab.exe
UninstallDisplayName=@APP_NAME@
OutputDir=Output
OutputBaseFilename=evolab-setup-{#AppVersion}
Compression=@COMPRESSION@
SolidCompression=yes
LZMAUseSeparateProcess=yes
; The GUI process holds this named mutex (evolab.winapp.create_app_mutex): Setup and Uninstall ask to close it.
AppMutex=@MUTEX@
CloseApplications=yes
RestartApplications=no
SetupLogging=yes
@SIGNING@

[Languages]
Name: "korean"; MessagesFile: "@MESSAGES_FILE@"

[CustomMessages]
@CUSTOM_MESSAGES@

[Tasks]
Name: "desktopicon"; Description: "{cm:TaskDesktop}"; GroupDescription: "{cm:TasksGroup}"

[InstallDelete]
; An upgrade first removes the old PyInstaller folder so that old DLL and .pyd files never mix with new ones (design D39).
Type: filesandordirs; Name: "{app}\_internal"

[Files]
Source: "@DIST@\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\@APP_NAME@"; Filename: "{app}\evolab.exe"; WorkingDir: "{app}"
Name: "{group}\{cm:ReportShortcut}"; Filename: "{app}\evolab.exe"; Parameters: "report --open"; WorkingDir: "{app}"
Name: "{autodesktop}\@APP_NAME@"; Filename: "{app}\evolab.exe"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\evolab.exe"; Description: "{cm:RunNow}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
Type: filesandordirs; Name: "{app}\_internal"

[Code]
const
  UninstallKey = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_ID@_is1';

// Takes the next dot-separated number off the front of S ("3.1.0" -> 3, S becomes "1.0").
function NextVersionPart(var S: String): Integer;
var
  P: Integer;
  T: String;
begin
  P := Pos('.', S);
  if P = 0 then
  begin
    T := S;
    S := '';
  end
  else
  begin
    T := Copy(S, 1, P - 1);
    S := Copy(S, P + 1, Length(S));
  end;
  Result := StrToIntDef(T, 0);
end;

// 1 if version A is newer than version B, 0 if they are the same, -1 if A is older (three numbers).
function CompareVersions(A, B: String): Integer;
var
  I, X, Y: Integer;
begin
  Result := 0;
  for I := 1 to 3 do
  begin
    X := NextVersionPart(A);
    Y := NextVersionPart(B);
    if X > Y then
    begin
      Result := 1;
      Exit;
    end;
    if X < Y then
    begin
      Result := -1;
      Exit;
    end;
  end;
end;

// Installing an older version over a newer one asks first; the default button and a silent setup say no (design D39).
function InitializeSetup(): Boolean;
var
  Installed: String;
begin
  Result := True;
  if RegQueryStringValue(HKA, UninstallKey, 'DisplayVersion', Installed) then
  begin
    Log('Installed version: ' + Installed + ', this setup: {#AppVersion}');
    if CompareVersions(Installed, '{#AppVersion}') > 0 then
      Result := SuppressibleMsgBox(FmtMessage(CustomMessage('NewerInstalled'), [Installed, '{#AppVersion}']),
        mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES;
    if not Result then
      Log('Downgrade refused.');
  end;
end;

// Deletes only the files the program keeps in its settings folder. RemoveDir succeeds only when nothing else is left.
procedure DeleteSettingsFiles(const Dir: String);
begin
  DeleteFile(Dir + '\settings.ini');
  DeleteFile(Dir + '\settings.ini.lock');
  DeleteFile(Dir + '\paths.ini');
  DelTree(Dir + '\logs', True, True, True);
  RemoveDir(Dir);
end;

// The data folder (environment files, runs, play records) is never deleted, whatever the answer (design D41).
// Settings and logs are deleted only when the user says yes; a silent uninstall and an all-users uninstall keep them.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  SettingsDir, DataDir: String;
begin
  if CurUninstallStep <> usPostUninstall then
    Exit;
  if UninstallSilent() then
  begin
    Log('Silent uninstall: settings and data folders kept.');
    Exit;
  end;
  if not IsAdminInstallMode() then
  begin
    SettingsDir := ExpandConstant('{localappdata}\@STATE_DIR_NAME@');
    if DirExists(SettingsDir) then
      if SuppressibleMsgBox(FmtMessage(CustomMessage('AskSettings'), [SettingsDir]),
          mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES then
        DeleteSettingsFiles(SettingsDir);
  end;
  DataDir := ExpandConstant('{userdocs}') + '\' + CustomMessage('DataDirName');
  SuppressibleMsgBox(FmtMessage(CustomMessage('DataKept'), [DataDir]), mbInformation, MB_OK, IDOK);
end;
