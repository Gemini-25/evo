{
  "format": "evolab-template", "version": 1,
  "id": "fixture_puck", "kind": "body", "world": "top",
  "name": "시험용 원형 몸",
  "description": "위에서 본 세계의 둥근 몸. 형식 1 부품만 씁니다(추진기 넷으로 밀고 바람 항력으로 멈춥니다).",
  "params": [
    {"id": "size", "label": "크기", "value": 1.0, "min": 0.6, "max": 1.6, "step": 0.05, "unit": "배", "main": true},
    {"id": "power", "label": "힘", "value": 1.0, "min": 0.4, "max": 2.5, "step": 0.1, "unit": "배", "main": true}
  ],
  "root": "disc",
  "parts": {
    "bodies": [
      {"id": "disc", "label": "몸", "pos": [0.0, 0.0],
       "shapes": [{"kind": "circle", "r": "=t.size * 0.3"}],
       "material": {"density": 100.0, "friction": 0.4}, "tags": ["player"], "drag": 2.0}
    ],
    "joints": [],
    "actuators": [
      {"kind": "thruster", "id": "t_right", "label": "오른쪽으로 밀기", "body": "disc", "dir": 0.0,
       "max_force": "=t.power * t.size * t.size * 60", "keys": ["Right"]},
      {"kind": "thruster", "id": "t_left", "label": "왼쪽으로 밀기", "body": "disc", "dir": 3.141592653589793,
       "max_force": "=t.power * t.size * t.size * 60", "keys": ["Left"]},
      {"kind": "thruster", "id": "t_up", "label": "위로 밀기", "body": "disc", "dir": 1.5707963267948966,
       "max_force": "=t.power * t.size * t.size * 60", "keys": ["Up"]},
      {"kind": "thruster", "id": "t_down", "label": "아래로 밀기", "body": "disc", "dir": -1.5707963267948966,
       "max_force": "=t.power * t.size * t.size * 60", "keys": ["Down"]}
    ],
    "sensors": [
      {"kind": "body_state", "id": "st", "label": "몸 상태", "body": "disc",
       "fields": ["x", "y", "vx", "vy"], "scale": {"x": 5.0, "y": 5.0, "vx": 3.0, "vy": 3.0}}
    ]
  },
  "slots": {}
}
